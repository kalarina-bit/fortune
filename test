/* =========================================================
   GITEA CUSTOM GLASS UI  (Light + Dark) — optimized
   ========================================================= */

/* ---------- Селектор темной темы ----------
   В Gitea класс висит на <html>. Чтобы не дублировать длинный
   :is(...) везде, задаём переменные один раз и работаем через var(). */

:root {
    /* light */
    --glass:            rgba(255,255,255,.62);
    --glass-strong:     rgba(255,255,255,.82);
    --border:           rgba(255,255,255,.72);
    --text:             #30343a;
    --muted:            #707780;

    --nav-bg:           rgba(255,255,255,.86);
    --nav-border:       rgba(255,255,255,.72);
    --nav-shadow:       0 3px 14px rgba(0,0,0,.055);

    --card-shadow:      0 4px 20px rgba(0,0,0,.045),
                        inset 0 1px 0 rgba(255,255,255,.65);
    --card-blur:        blur(16px) saturate(140%);

    --footer-color:     rgba(0,0,0,.35);
    --footer-bg:        rgba(255,255,255,.45);
    --footer-border:    rgba(255,255,255,.5);

    --btn-bg:           rgba(0,0,0,.04);
    --btn-bg-hover:     rgba(0,0,0,.07);
    --btn-border:       rgba(0,0,0,.08);
    --btn-color:        var(--text);
    --btn-shadow:       0 2px 8px rgba(0,0,0,.05);

    --primary:          rgba(74,144,226,.90);
    --primary-hover:    rgba(84,155,238,1);
    --danger:           rgba(205,65,65,.90);
    --danger-hover:     rgba(220,75,75,1);
    --success:          rgba(62,145,91,.90);
    --success-hover:    rgba(72,160,102,1);

    --input-bg:         rgba(255,255,255,.75);
    --input-border:     rgba(0,0,0,.12);
    --input-color:      var(--text);
    --input-shadow:     inset 0 1px 3px rgba(0,0,0,.05);
    --input-focus:      rgba(74,144,226,.55);

    --dropdown-bg:      rgba(255,255,255,.96);
    --dropdown-border:  rgba(0,0,0,.08);
    --dropdown-shadow:  0 14px 42px rgba(0,0,0,.15);
    --hover-soft:       rgba(0,0,0,.045);
    --line-soft:        rgba(0,0,0,.06);

    --bg-image:
        radial-gradient(circle at 20% 10%, rgba(255,255,255,.95), transparent 45%),
        radial-gradient(circle at 80% 90%, rgba(220,228,235,.38), transparent 50%),
        linear-gradient(160deg, #e8eef2 0%, #f4f7f9 40%, #e9eef2 100%);
}

/* Переопределение переменных для темной темы — единственное место
   с длинным селектором */
html.theme-gitea-dark,
html.theme-arc-green,
html.theme-gitea-auto.theme-gitea-dark {
    --glass:            rgba(25,28,34,.68);
    --glass-strong:     rgba(22,25,30,.90);
    --border:           rgba(255,255,255,.075);
    --text:             #d9dde2;
    --muted:            #9299a2;

    --nav-bg:           rgba(18,20,25,.88);
    --nav-border:       rgba(255,255,255,.055);
    --nav-shadow:       0 7px 30px rgba(0,0,0,.32);

    --card-shadow:      0 10px 36px rgba(0,0,0,.32),
                        inset 0 1px 0 rgba(255,255,255,.025);
    --card-blur:        blur(18px) saturate(120%);

    --footer-color:     rgba(255,255,255,.35);
    --footer-bg:        rgba(18,20,25,.52);
    --footer-border:    rgba(255,255,255,.05);

    --btn-bg:           rgba(255,255,255,.085);
    --btn-bg-hover:     rgba(255,255,255,.13);
    --btn-border:       rgba(255,255,255,.105);
    --btn-color:        #d9dde2;
    --btn-shadow:       0 2px 8px rgba(0,0,0,.12);

    --primary:          rgba(74,144,226,.88);
    --primary-hover:    rgba(84,155,238,.98);
    --danger:           rgba(205,65,65,.88);
    --danger-hover:     rgba(220,75,75,.98);
    --success:          rgba(62,145,91,.88);
    --success-hover:    rgba(72,160,102,.98);

    --input-bg:         rgba(8,10,13,.58);
    --input-border:     rgba(255,255,255,.10);
    --input-color:      #d8dce1;
    --input-shadow:     inset 0 1px 3px rgba(0,0,0,.25);
    --input-focus:      rgba(255,255,255,.22);

    --dropdown-bg:      rgba(22,24,29,.96);
    --dropdown-border:  rgba(255,255,255,.075);
    --dropdown-shadow:  0 14px 42px rgba(0,0,0,.45);
    --hover-soft:       rgba(255,255,255,.05);
    --line-soft:        rgba(255,255,255,.055);

    --bg-image:
        radial-gradient(circle at 15% 10%, rgba(255,255,255,.035), transparent 40%),
        radial-gradient(circle at 85% 90%, rgba(255,255,255,.02), transparent 45%),
        linear-gradient(145deg, #0f1115 0%, #16191e 50%, #111317 100%);
}

/* =========================================================
   1. Скрытие системных элементов
   ========================================================= */

:is(
    a.item[href*="docs.gitea.com"],
    a.item[href*="/help"],
    a.item[href*="/explore/organizations"],

    footer .left,
    footer .ui.left,
    footer .footer-left,
    footer .power-by,
    footer .ui.left.links,
    footer .ui.left.menu,
    footer .ui.container > .left,

    footer a[href*="gitea.com"],
    footer a[href*="gitea.io"],
    footer a[href*="gitea.dev"],
    footer a[href*="github.com/go-gitea"],
    footer a[href*="/api/"],
    footer a[href*="licenses"],

    footer .ui.right > span,
    footer .ui.right.links > span,
    footer .ui.right > a[href*="/api/"],
    footer .ui.right > a[href*="/licenses"],
    footer .ui.right .version,
    footer .ui.right .page,
    footer .ui.right .template,
    footer .ui.right .power-by,

    .page-content.home .ui.stackable.grid .eight.wide.column,
    .page-content.home .features,
    .page-content.home .hero + .ui.stackable.grid
) {
    display: none !important;
}

/* =========================================================
   2. Фон
   ========================================================= */

html,
body {
    min-height: 100vh !important;
    background: var(--bg-image) !important;
    background-attachment: fixed !important;
    color: var(--text) !important;
}

/* =========================================================
   3. Общий glass
   ========================================================= */

:is(
    .ui.segment,
    .ui.segments,
    .box,
    .markup,
    .repository.file.list,
    .repository .diff-file-box,
    .repository .ui.attached.segment,
    .ui.card,
    .ui.cards > .card
) {
    background: var(--glass) !important;
    backdrop-filter: var(--card-blur) !important;
    -webkit-backdrop-filter: var(--card-blur) !important;
    border: 1px solid var(--border) !important;
    box-shadow: var(--card-shadow) !important;
    border-radius: 14px !important;
}

/* =========================================================
   4. Navbar
   ========================================================= */

.ui.menu {
    background: var(--nav-bg) !important;
    border: 1px solid var(--nav-border) !important;
    box-shadow: var(--nav-shadow) !important;
    margin-bottom: 18px !important;
    border-radius: 0 0 12px 12px !important;
    backdrop-filter: blur(18px) saturate(145%) !important;
    -webkit-backdrop-filter: blur(18px) saturate(145%) !important;
}

.ui.menu .item {
    color: var(--text) !important;
}

.ui.menu .item:hover {
    background: var(--hover-soft) !important;
}

/* =========================================================
   5. Inputs
   ========================================================= */

input,
textarea,
select {
    background: var(--input-bg) !important;
    border: 1px solid var(--input-border) !important;
    color: var(--input-color) !important;
    border-radius: 9px !important;
    box-shadow: var(--input-shadow) !important;
}

input:focus,
textarea:focus,
select:focus {
    border-color: var(--input-focus) !important;
    box-shadow:
        0 0 0 2px color-mix(in srgb, var(--input-focus) 25%, transparent),
        var(--input-shadow) !important;
}

/* =========================================================
   6. Кнопки
   ========================================================= */

.ui.button {
    background: var(--btn-bg) !important;
    border: 1px solid var(--btn-border) !important;
    color: var(--btn-color) !important;
    box-shadow: var(--btn-shadow) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    border-radius: 9px !important;
    transition:
        background .18s ease,
        border-color .18s ease,
        box-shadow .18s ease,
        transform .18s ease !important;
}

.ui.button:hover {
    background: var(--btn-bg-hover) !important;
    border-color: var(--input-focus) !important;
    box-shadow: 0 4px 14px rgba(0,0,0,.18) !important;
    transform: translateY(-1px);
}

/* Primary / submit */
.ui.primary.button,
.ui.primary.buttons .button,
button[type="submit"],
input[type="submit"] {
    background: var(--primary) !important;
    border: 1px solid rgba(255,255,255,.16) !important;
    color: #fff !important;
    font-weight: 600 !important;
    box-shadow:
        0 4px 14px rgba(0,0,0,.25),
        inset 0 1px 0 rgba(255,255,255,.16) !important;
}

.ui.primary.button:hover,
.ui.primary.buttons .button:hover,
button[type="submit"]:hover,
input[type="submit"]:hover {
    background: var(--primary-hover) !important;
    border-color: rgba(255,255,255,.22) !important;
    box-shadow:
        0 6px 18px rgba(0,0,0,.32),
        inset 0 1px 0 rgba(255,255,255,.2) !important;
}

/* Success */
.ui.positive.button,
.ui.green.button {
    background: var(--success) !important;
    border: 1px solid rgba(255,255,255,.13) !important;
    color: #fff !important;
    font-weight: 600 !important;
    box-shadow: 0 4px 14px rgba(0,0,0,.25) !important;
}
.ui.positive.button:hover,
.ui.green.button:hover {
    background: var(--success-hover) !important;
}

/* Danger */
.ui.negative.button,
.ui.red.button {
    background: var(--danger) !important;
    border: 1px solid rgba(255,255,255,.13) !important;
    color: #fff !important;
    font-weight: 600 !important;
    box-shadow: 0 4px 14px rgba(0,0,0,.25) !important;
}
.ui.negative.button:hover,
.ui.red.button:hover {
    background: var(--danger-hover) !important;
}

/* =========================================================
   7. Dropdown
   ========================================================= */

.ui.dropdown .menu {
    background: var(--dropdown-bg) !important;
    backdrop-filter: blur(18px) !important;
    -webkit-backdrop-filter: blur(18px) !important;
    border: 1px solid var(--dropdown-border) !important;
    box-shadow: var(--dropdown-shadow) !important;
    border-radius: 10px !important;
}

.ui.dropdown .menu > .item:hover {
    background: var(--hover-soft) !important;
}

/* =========================================================
   8. Repository file list
   ========================================================= */

.repository.file.list {
    overflow: hidden !important;
}
.repository.file.list .item {
    border-color: var(--line-soft) !important;
}
.repository.file.list .item:hover {
    background: var(--hover-soft) !important;
}

/* =========================================================
   9. Links
   ========================================================= */

a {
    transition: color .15s ease, opacity .15s ease !important;
}

/* =========================================================
   10. Footer
   ========================================================= */

footer {
    min-height: 32px !important;
    padding: 6px 18px !important;
    color: var(--footer-color) !important;
    background: var(--footer-bg) !important;
    border: 1px solid var(--footer-border) !important;
    border-radius: 12px 12px 0 0 !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
}
footer .ui.container { min-height: 0 !important; }
footer .ui.right     { margin-left: 0 !important; }

/* =========================================================
   11. Scrollbar (только dark, чтобы не ломать light)
   ========================================================= */

html.theme-gitea-dark ::-webkit-scrollbar,
html.theme-arc-green ::-webkit-scrollbar,
html.theme-gitea-auto.theme-gitea-dark ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}
html.theme-gitea-dark ::-webkit-scrollbar-track,
html.theme-arc-green ::-webkit-scrollbar-track,
html.theme-gitea-auto.theme-gitea-dark ::-webkit-scrollbar-track {
    background: transparent;
}
html.theme-gitea-dark ::-webkit-scrollbar-thumb,
html.theme-arc-green ::-webkit-scrollbar-thumb,
html.theme-gitea-auto.theme-gitea-dark ::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,.12);
    border-radius: 10px;
}
html.theme-gitea-dark ::-webkit-scrollbar-thumb:hover,
html.theme-arc-green ::-webkit-scrollbar-thumb:hover,
html.theme-gitea-auto.theme-gitea-dark ::-webkit-scrollbar-thumb:hover {
    background: rgba(255,255,255,.20);
}

/* =========================================================
   12. Mobile
   ========================================================= */

@media (max-width: 768px) {
    .ui.menu {
        border-radius: 0 0 10px 10px !important;
        margin-bottom: 12px !important;
    }
    :is(.ui.segment, .box, .repository.file.list) {
        border-radius: 11px !important;
    }
    footer {
        padding: 5px 12px !important;
        border-radius: 10px 10px 0 0 !important;
    }
}

